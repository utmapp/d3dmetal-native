_D3D12SerializeRootSignature
_D3D12SerializeVersionedRootSignature
_D3D12CreateRootSignatureDeserializer
_D3D12CreateVersionedRootSignatureDeserializer
_D3D12EnableExperimentalFeatures
_DXGIDeclareAdapterRemovalSupport
_D3DCompile
_D3DCompileFromFile
_D3D10CreateBlob
# Public-API replacements for D3DMetal's private imports (dmn_import_shims.mm).
# The dmn_* functions are covered above; the class is bound by name from a
# D3DMetal patched with scripts/patch_d3dmetal_imports.py.
_OBJC_CLASS_$_DMNAccelerationStructureAllocationDescriptor
_OBJC_METACLASS_$_DMNAccelerationStructureAllocationDescriptor
