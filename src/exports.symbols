# Exported symbols for libd3dmetal-native.dylib (ld64 -exported_symbols_list).
# The dmn_* C API plus the D3D entry points consumers link against
# (apps link this library, not the framework).
_dmn_*
_D3D11CreateDevice
_D3D11CreateDeviceAndSwapChain
_CreateDXGIFactory
_CreateDXGIFactory1
_CreateDXGIFactory2
_D3D12CreateDevice
